    {
      "name": "CRUD",
      "item": [
        {
          "name": "01 Get booking ids",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Response is a non-empty array\", () => pm.expect(json).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"Each item has numeric bookingid\", () => json.slice(0, 20).forEach(i => pm.expect(i.bookingid).to.be.a(\"number\")));",
                  "pm.test(\"Response time < 3000ms\", () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "02 Create booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Генерируем уникальные данные, чтобы не зависеть от чужих записей на общем стенде",
                  "const names = ['Ivan','Olga','Petr','Anna','Sergey','Maria'];",
                  "pm.environment.set('firstname', names[Math.floor(Math.random()*names.length)] + Date.now().toString().slice(-4));",
                  "pm.environment.set('totalprice', Math.floor(Math.random()*900) + 100);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"bookingid is a number\", () => pm.expect(json.bookingid).to.be.a(\"number\"));",
                  "pm.test(\"firstname and totalprice match request\", () => {",
                  "    pm.expect(json.booking.firstname).to.eql(pm.environment.get(\"firstname\"));",
                  "    pm.expect(json.booking.totalprice).to.eql(Number(pm.environment.get(\"totalprice\")));",
                  "});",
                  "pm.test(\"lastname and depositpaid match request\", () => {",
                  "    pm.expect(json.booking.lastname).to.eql(\"Petrov\");",
                  "    pm.expect(json.booking.depositpaid).to.be.true;",
                  "});",
                  "pm.test(\"bookingdates match request\", () => pm.expect(json.booking.bookingdates).to.eql({checkin: \"2026-11-01\", checkout: \"2026-11-05\"}));",
                  "pm.test(\"Response time < 3000ms\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "pm.environment.set(\"bookingId\", json.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"Petrov\",\n  \"totalprice\": {{totalprice}},\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-11-01\",\n    \"checkout\": \"2026-11-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "03 Get booking by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const schema = {",
                  "  type: \"object\",",
                  "  required: [\"firstname\",\"lastname\",\"totalprice\",\"depositpaid\",\"bookingdates\"],",
                  "  properties: {",
                  "    firstname: {type: \"string\"},",
                  "    lastname: {type: \"string\"},",
                  "    totalprice: {type: \"number\"},",
                  "    depositpaid: {type: \"boolean\"},",
                  "    bookingdates: {",
                  "      type: \"object\",",
                  "      required: [\"checkin\",\"checkout\"],",
                  "      properties: { checkin: {type: \"string\"}, checkout: {type: \"string\"} }",
                  "    },",
                  "    additionalneeds: {type: \"string\"}",
                  "  }",
                  "};",
                  "",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Body matches JSON schema\", () => pm.response.to.have.jsonSchema(schema));",
                  "pm.test(\"firstname is the one we created\", () => pm.expect(pm.response.json().firstname).to.eql(pm.environment.get(\"firstname\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
